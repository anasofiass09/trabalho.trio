@model sistemaagendamento.Models.Pagamento
@{ ViewData["Title"] = "Editar Pagamento"; }
<h2>Editar Pagamento</h2>
<form asp-action="Edit" asp-route-id="@Model.Codigo" method="post" class="col-md-7">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Codigo" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="AgendamentoId" class="form-label">Agendamento</label><select asp-for="AgendamentoId" class="form-select" asp-items="ViewBag.AgendamentoId"><option value="">Selecione...</option></select><span asp-validation-for="AgendamentoId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Valor" class="form-label">Valor</label><input asp-for="Valor" type="number" step="0.01" class="form-control" /><span asp-validation-for="Valor" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="FormaPagamento" class="form-label">Forma de pagamento</label><input asp-for="FormaPagamento" type="text" class="form-control" /><span asp-validation-for="FormaPagamento" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="DataPagamento" class="form-label">Data de pagamento</label><input asp-for="DataPagamento" type="datetime-local" class="form-control" /><span asp-validation-for="DataPagamento" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Situacao" class="form-label">Situacao</label><input asp-for="Situacao" type="text" class="form-control" /><span asp-validation-for="Situacao" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Salvar alteracoes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
