@model sistemaagendamento.Models.Categoria
@{ ViewData["Title"] = "Editar Categoria"; }
<h2>Editar Categoria</h2>
<form asp-action="Edit" asp-route-id="@Model.Codigo" method="post" class="col-md-7">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Codigo" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Nome" class="form-label">Nome</label><input asp-for="Nome" type="text" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Descricao" class="form-label">Descricao</label><textarea asp-for="Descricao" class="form-control" rows="3"></textarea><span asp-validation-for="Descricao" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Salvar alteracoes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
