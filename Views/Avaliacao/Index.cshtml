@model IEnumerable<sistemaagendamento.Models.Avaliacao>

@{
    ViewData["Title"] = "Avaliações";
}

<h2>Avaliações dos Serviços</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Nova Avaliação</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Agendamento Nº</th>
            <th>Serviço</th>
            <th>Nota</th>
            <th>Comentário</th>
            <th>Data</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.AgendamentoId</td>
                <td>@item.Agendamento?.Servico?.Nome</td>
                <td>⭐ @item.Nota / 5</td>
                <td>@item.Comentario</td>
                <td>@item.DataAvaliacao.ToString("dd/MM/yyyy")</td>
            </tr>
        }
    </tbody>
</table>