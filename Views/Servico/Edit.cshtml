@model sistemaagendamento.Models.Servico
@{ ViewData["Title"] = "Editar Servico"; }
<h2>Editar Servico</h2>
<form asp-action="Edit" asp-route-id="@Model.Codigo" method="post" class="col-md-7">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Codigo" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Nome" class="form-label">Nome</label><input asp-for="Nome" type="text" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Descricao" class="form-label">Descricao</label><textarea asp-for="Descricao" class="form-control" rows="3"></textarea><span asp-validation-for="Descricao" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Preco" class="form-label">Preco (R$)</label><input asp-for="Preco" type="number" step="0.01" class="form-control" /><span asp-validation-for="Preco" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="DuracaoMinutos" class="form-label">Duracao em minutos</label><input asp-for="DuracaoMinutos" type="number" class="form-control" /><span asp-validation-for="DuracaoMinutos" class="text-danger"></span></div>
    <div class="form-check mb-3"><input asp-for="Ativo" class="form-check-input" type="checkbox" /><label asp-for="Ativo" class="form-check-label">Ativo</label></div>
    <div class="mb-3"><label asp-for="CodigoCategoria" class="form-label">Categoria</label><select asp-for="CodigoCategoria" class="form-select" asp-items="ViewBag.CategoriaId"><option value="">Selecione...</option></select><span asp-validation-for="CodigoCategoria" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="CodigoPrestador" class="form-label">Prestador</label><select asp-for="CodigoPrestador" class="form-select" asp-items="ViewBag.PrestadorId"><option value="">Selecione...</option></select><span asp-validation-for="CodigoPrestador" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Salvar alteracoes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
