@model sistemaagendamento.Models.Servico

@{
    ViewData["Title"] = "Novo Serviço";
}

<h2>Cadastrar Serviço</h2>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Descricao" class="control-label"></label>
                <textarea asp-for="Descricao" class="form-control"></textarea>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Preco" class="control-label"></label>
                <input asp-for="Preco" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DuracaoMinutos" class="control-label">Duração (Minutos)</label>
                <input asp-for="DuracaoMinutos" class="form-control" />
                <span asp-validation-for="DuracaoMinutos" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CodigoCategoria" class="control-label">Categoria</label>
                <select asp-for="CodigoCategoria"
                        class="form-select"
                        asp-items="ViewBag.CategoriaId">
                    <option value="">Selecione uma categoria</option>
                </select>
                <span asp-validation-for="CodigoCategoria" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CodigoPrestador" class="control-label">Prestador</label>
                <select asp-for="CodigoPrestador"
                        class="form-select"
                        asp-items="ViewBag.PrestadorId">
                    <option value="">Selecione um prestador</option>
                </select>
                <span asp-validation-for="CodigoPrestador" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>